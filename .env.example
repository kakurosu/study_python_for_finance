# ============================================================
# Study Python for Finance — 環境変数テンプレート
#
# このファイルを `.env` という名前でコピーし、必要な行のコメント (#)
# を外して値を編集してください。`.env` がない、または該当行が `#` で
# コメントアウトされている場合は、その項目は未設定として扱われます。
#
# `run.bat` / `setup.bat` がここから自動で値を取り込みます。
# ============================================================


# ============================================================
# 既定の挙動（.env なしでも勝手にこうなる）
# ============================================================
# run.bat / setup.bat は下記を自動設定します。.env で上書き可能。
#
#   PYTHONIOENCODING = utf-8                 (cp932 stdout エラー回避)
#   PYTHONUTF8       = 1                     (UTF-8 モード)
#   UV_LINK_MODE     = copy                  (OneDrive/共有 DR の hardlink 非対応回避)
#   UV_PROJECT_ENVIRONMENT = %LOCALAPPDATA%\studypy\venv
#       → .venv は各ユーザーのローカルディスクに作る。OneDrive 配下の
#         プロジェクトに置いても自動でローカルにフォールバック。


# ============================================================
# Proxy 設定（必要なときだけ有効化）
# ============================================================
# 社内ネットワーク等で proxy 経由のアクセスが必要な場合のみ、
# 下の行の # を外して proxy URL に書き換えてください。
#
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1


# ============================================================
# uv キャッシュ場所（個人運用ならデフォルトで OK）
# ============================================================
# uv はダウンロードしたパッケージをキャッシュに保存し、.venv 構築時に
# そこから取り出します。デフォルトは %LOCALAPPDATA%\uv\cache（各ユーザー）。
#
# 共有ドライブにキャッシュを置けば「最初の 1 人がダウンロード、残り 59 人は
# そこから読む」が可能（ただし負荷面の注意点は下記セクション参照）。
#
# UV_CACHE_DIR=Z:\studypy\uv-cache


# ============================================================
# .venv の場所
# ============================================================
# 既定では %LOCALAPPDATA%\studypy\venv（各ユーザーのローカルディスク）。
# 共有ドライブに .venv を置くのは絶対に避けてください:
#   - hardlink が効かず毎回フルコピーで遅い
#   - 別ユーザーや別 Python バージョンでは利用不可（共有しても意味なし）
#   - ファイルロック競合
#
# 個別の場所に変えたい場合のみ:
# UV_PROJECT_ENVIRONMENT=D:\studypy_venv


# ============================================================
# 大規模運用シナリオ（同時 ~60 人で使う場合）
# ============================================================
# 想定: クラス・研修で 60 人前後の参加者が一斉に起動する。
#
# ---------- 推奨アーキテクチャ ----------
#   共有ドライブ (例: Z:\studypy\)
#     ├── プロジェクト本体（content/, app/, scripts/ ...）  ← 読み取り専用
#     └── uv-cache/                                          ← 管理者が事前投入
#
#   各ユーザーのローカル (%LOCALAPPDATA%\studypy\)
#     └── venv\                                              ← 各自で生成 (自動)
#
# ---------- 手順 ----------
# 1) 【管理者が 1 回だけ】
#    共有ドライブにプロジェクトを置く。
#    管理者の PC で下記を .env に書いて setup.bat を実行
#    → 共有 uv-cache が全パッケージで満たされる。
#
#       UV_CACHE_DIR=Z:\studypy\uv-cache
#
# 2) 【各参加者が 1 回だけ】
#    プロジェクトと同じ場所にこの .env をコピーし、UV_CACHE_DIR の
#    コメントアウトを外して上記と同じパスにする。
#    setup.bat をダブルクリック → 共有キャッシュから自分のローカル venv に
#    展開（PyPI への外向き通信なし、5〜10 分）。
#
# 3) 【日常使用】
#    run.bat をダブルクリック。venv はローカルにあるので高速起動。
#
# ---------- 負荷見積もり ----------
# A) 初回 setup を 60 人同時実行する場合（最悪ケース）:
#    - 1 ユーザーあたり ~2GB を共有ドライブから読み出す
#    - 60 人同時 = 共有ドライブから ~120GB の読み出し
#    - Gigabit LAN (実効 ~100MB/s) で 20〜30 分の待ち時間
#    - 共有 SMB サーバの I/O が頭打ちになる可能性大
#    対策:
#      - 10 人ずつ等で時間差スタート（5〜10 分間隔）
#      - 共有ドライブを高速 NAS / SSD で構成
#      - 各 PC のローカルキャッシュ運用（UV_CACHE_DIR を未設定にして
#        各自 PyPI からダウンロード = 外向きトラフィック分散）も選択肢
#
# B) 日常使用（run.bat 同時起動 60 人）:
#    - venv はローカル → uv sync は数秒の no-op
#    - 共有ドライブ I/O は YAML 読み込み数百 KB のみ
#    - 各ユーザーの FastAPI は 127.0.0.1 で動くので server 側の競合なし
#    - 60 人同時起動でも問題なし
#
# C) PyPI 直接ダウンロード 60 人同時（UV_CACHE_DIR 未設定の場合）:
#    - 60 人 × 1.5GB = 90GB を組織の出口回線で消費
#    - PyPI 側のレートリミットは個別 IP 単位なのでまず引っかからない
#    - 組織の上流回線次第。スループット不足なら setup ロケーション分散
#
# ---------- ポート競合について ----------
# 各ユーザーが個別 PC で動かす想定なら 127.0.0.1:8765 は競合しません。
# 1 台の Windows Server に複数セッション (RDP / Terminal Services) で
# 同時アクセスする場合のみ要注意 — その場合は run.bat の代わりに
# `uv run study-python --port 0` で空きポート自動選択にしてください。


# ============================================================
# OpenAI API キー（章 24 でのみ使用、任意）
# ============================================================
# OPENAI_API_KEY=sk-...
