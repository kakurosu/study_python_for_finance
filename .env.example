# ============================================================
# Study Python for Finance — 環境変数テンプレート
#
# このファイルを `.env` という名前でコピーし、必要な行のコメント (#)
# を外して値を編集してください。`.env` がない、または該当行が `#` で
# コメントアウトされている場合は、その項目は未設定として扱われます。
#
# `run.bat` / `setup.bat` がここから自動で値を取り込みます。
# ============================================================


# ============================================================
# 既定の挙動（.env なしでも自動でこうなる）
# ============================================================
# run.bat / setup.bat は下記を自動設定します。.env で上書き可能。
#
#   PYTHONIOENCODING = utf-8                 (cp932 stdout エラー回避)
#   PYTHONUTF8       = 1                     (UTF-8 モード)
#   UV_LINK_MODE     = copy                  (OneDrive/共有 DR の hardlink 非対応回避)
#   UV_PYTHON_DOWNLOADS  = never             (uv が GitHub から CPython を取得しない)
#   UV_PYTHON_PREFERENCE = only-system       (システム既存の Python しか使わない)
#   UV_PROJECT_ENVIRONMENT = %LOCALAPPDATA%\studypy\venv
#       → .venv は各ユーザーのローカルディスクに作る
#   STUDYPY_DATA_DIR = (未設定)
#       → Python 側で自動解決:
#         a) 既に project_root\progress.json があればそこを使う（互換）
#         b) なければ %LOCALAPPDATA%\studypy\ を使う（per-user 推奨）
#
# セキュリティポリシー:
#   - uv は python-build-standalone (Astral の GitHub プロジェクト) からの
#     CPython 取得を**しない**設定で動かします。Python 3.13 は事前に
#     winget もしくは python.org の公式インストーラで導入してください。
#   - パッケージ取得は PyPI (pypi.org) からのみ。uv.lock に固定された
#     ハッシュで検証されます。GitHub URL 指定の依存は pyproject.toml に
#     一つもありません (確認: `grep "git+" pyproject.toml uv.lock`)。


# ============================================================
# Proxy 設定（必要なときだけ有効化）
# ============================================================
# 社内ネットワーク等で proxy 経由のアクセスが必要な場合のみ、
# 下の行の # を外して proxy URL に書き換えてください。
#
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1


# ============================================================
# uv キャッシュ場所
# ============================================================
# 既定: %LOCALAPPDATA%\uv\cache（各ユーザー）
#
# ★ UV_CACHE_DIR を共有ドライブに向けるのは NG。
#   uv は sdist-only パッケージ (pytweening 等) を毎回ビルドしようとし、
#   その際 cache へ書込みが必要なので「共有 cache を read-only で使い回す」
#   構成は確実に PermissionError で失敗します。
#
# 代わりに UV_CACHE_SEED_DIR を使ってください (下記セクション参照)。
#
# 個別の理由でローカルキャッシュ場所を変えたい場合のみ:
# UV_CACHE_DIR=D:\uv\cache


# ============================================================
# 共有 cache の正しい使い方 (UV_CACHE_SEED_DIR)
# ============================================================
# 目的: 一人がセットアップすれば残りのユーザは PyPI へのアクセス不要で
#       セットアップを完了できる状態にする。
#
# 仕組み:
#   1) 【管理者】普通に setup.bat を 1 回実行 → 自分の
#      %LOCALAPPDATA%\uv\cache に必要な全パッケージが揃う。
#   2) 【管理者】そのフォルダを共有ドライブにコピー (例: Z:\studypy\uv-seed)。
#      共有先は **read-only** で OK。書込み権限は不要。
#   3) 【各参加者】.env に UV_CACHE_SEED_DIR を設定。
#      setup.bat / run.bat が初回 1 回だけ「seed → 自分のローカル cache」
#      へ robocopy で同期 (~1.5-2GB, 5-15 分)。
#      以降は完全にローカル cache を使うので共有ドライブへの読書きゼロ。
#
# 共有 seed に置く / 置かないフォルダ:
#   置く     archive-v0, sdists-v9, wheels-v5, simple-v18, simple-v21,
#            git-v0, interpreter-v4 (任意)
#   除外     environments-v2 (per-machine 状態, 持ち込み不可),
#            builds-v0 (一時ビルド領域, 不要)
#   setup.bat の robocopy は /XD environments-v2 builds-v0 を自動付与。
#
# UV_CACHE_SEED_DIR=Z:\studypy\uv-seed


# ============================================================
# .venv の場所
# ============================================================
# 既定: %LOCALAPPDATA%\studypy\venv（各ユーザーのローカル）
# 共有ドライブに置くと hardlink 不可・別バージョン Python で使えない
# などの理由で必ず壊れるため、変更非推奨。
#
# UV_PROJECT_ENVIRONMENT=D:\studypy_venv


# ============================================================
# 学習データ (progress.json, logs/) の保存場所
# ============================================================
# 既定: 自動判定（既存 progress.json があれば project_root、なければ
#       %LOCALAPPDATA%\studypy\）
# 100 人規模デプロイで共有プロジェクトを使う場合、明示的に各ユーザーの
# ローカルパスにすること（共有ファイルへの書込み競合を回避）。
#
# STUDYPY_DATA_DIR=%LOCALAPPDATA%\studypy


# ============================================================
# 大規模運用シナリオ（同時 ~100 人で使う場合）
# ============================================================
# 想定: クラス・研修で 100 人前後が一斉に起動する。
#
# ---------- 推奨アーキテクチャ ----------
#   共有ドライブ (例: Z:\studypy\)
#     ├── プロジェクト本体（content/, app/, scripts/ ...）  ← 読み取り専用
#     └── uv-seed/                                           ← 管理者の cache のコピー (read-only)
#
#   各ユーザーのローカル (%LOCALAPPDATA%\studypy\, %LOCALAPPDATA%\uv\cache)
#     ├── venv\                                  ← 自動 fallback (各自で生成)
#     ├── uv\cache\                              ← seed から初回コピー
#     ├── progress.json                          ← 学習進捗
#     └── logs\app.log                           ← ログ
#
# ---------- 必須設定 (.env サンプル) ----------
#   UV_CACHE_SEED_DIR=Z:\studypy\uv-seed
#   STUDYPY_DATA_DIR=%LOCALAPPDATA%\studypy
#   # UV_CACHE_DIR / UV_PROJECT_ENVIRONMENT は未設定で OK（自動 fallback）
#
# ---------- 手順 ----------
# 1) 【管理者が 1 回だけ】
#    自分の書込み可能な PC で setup.bat を実行。終わったら
#    %LOCALAPPDATA%\uv\cache 配下を共有ドライブの uv-seed/ にコピー。
#    （フォルダごと xcopy / robocopy で OK。environments-v2 と builds-v0
#    は除外推奨だが、含まれていても後続ユーザーの setup.bat 側で除外される。）
#
# 2) 【各参加者が 1 回だけ】
#    プロジェクト直下に .env を配置（UV_CACHE_SEED_DIR を上の seed パスに設定）。
#    setup.bat をダブルクリック → seed をローカル cache に robocopy で
#    展開（PyPI への外向き通信なし、5-15 分）。
#
# 3) 【日常使用】
#    run.bat をダブルクリック。venv・cache・progress・logs すべて
#    ローカルなので数秒で起動。共有ドライブへの書込みなし。
#
# ---------- 負荷見積もり (100 人同時) ----------
# A) 初回 setup を 100 人同時実行する場合（最悪ケース）:
#    - 1 ユーザーあたり ~2GB を共有 DR から読み出す
#    - 100 人同時 = 共有 DR から最大 200GB の読み出し
#    - Gigabit LAN (実効 100MB/s): 純 I/O だけで 30 分超
#    - SMB サーバの I/O・接続数で実測はもっと遅くなる (60-120 分の可能性)
#
#    対策 (強く推奨):
#    - **10〜20 人ずつ時間差スタート** (5-10 分間隔)
#    - 共有 NAS を 10GbE / SSD 構成にする
#    - IT 部門に依頼して事前に各 PC へ venv をデプロイ（最終手段）
#    - 社内 PyPI ミラー (devpi-server 等) を立てて UV_CACHE_DIR は各自ローカル
#      にする → 共有 DR のボトルネックを完全に回避
#
# B) 日常使用（run.bat 同時起動 100 人）:
#    - venv / progress.json / logs すべてローカル
#    - 共有 DR へのアクセスは YAML 読込み (~数百 KB) のみ
#    - 各ユーザーの FastAPI は 127.0.0.1 で動くので server 側競合なし
#    - **100 人同時起動でも問題なし** ✅
#
# C) progress.json 書込み競合について:
#    - STUDYPY_DATA_DIR を各ユーザーローカルに設定すれば競合は発生しない
#    - **これを設定しないと 100 人が共有 1 ファイルに書込み → データ破損確定**
#    - 必ず .env に STUDYPY_DATA_DIR=%LOCALAPPDATA%\studypy を入れること
#
# D) 出口回線のキャパシティ:
#    - 共有 cache を使う場合: 外向き通信なし
#    - 共有 cache を使わず各自 PyPI から DL する場合:
#      100 人 × 1.5GB = 150GB を組織の出口回線で消費
#      Gigabit 出口なら 20-40 分待ち、専用線 100Mbps なら 4 時間以上
#
# ---------- ポート競合について ----------
# 各ユーザーが個別 PC で動かす想定なら 127.0.0.1:8765 は競合しません。
# 1 台の Windows Server に複数セッション (RDP / Terminal Services) で
# 100 人ぶら下げる構成の場合は別問題:
#   - ポート: --port 0 で空きポート自動選択
#   - メモリ: 1 セッション ~300MB → 100 人で 30GB
#   - CPU: kernel + uvicorn + Python は CPU を食う、コア数次第
#   - 強く非推奨。各 PC で動かす構成を推奨。


# ============================================================
# 日本語パス・UNC パスでの運用について
# ============================================================
# プロジェクトを日本語名のフォルダや、共有ファイルサーバ (UNC パス
# \\fileserver\共有\study_python_finance など) に配置しても動作する
# ように、run.bat / setup.bat には下記の対応が入っています。
#
#   1) `chcp 65001`
#      コンソール表示を UTF-8 にする。Python が PYTHONIOENCODING=utf-8
#      で吐く日本語ログ / エラーが cp932 console で文字化けするのを防ぐ。
#
#   2) `pushd "%~dp0"`
#      `cd /d` は UNC パスに失敗する (cmd の伝統的制約)。pushd なら
#      \\server\share\日本語フォルダ\... も一時的にドライブ文字へ
#      マップして cd できる。
#
#   3) Python 3.11+ で動作
#      Python 3.11 / 3.12 は本来 site.py の `.pth` 読み込みに locale
#      (cp932) を使うため、日本語パスを含む `.pth` を起動時に読めない。
#      setup.bat / run.bat では `uv sync --no-install-project` を使い、
#      プロジェクト自身のための `.pth` ファイル
#      (_editable_impl_study_python_finance.pth) を**生成しない**
#      ようにしているので、3.11 / 3.12 でも問題なし。
#      これにより別 PC に Python 3.11 しかなくても起動可能。
#
#   4) `UV_PROJECT_ENVIRONMENT = %LOCALAPPDATA%\studypy\venv`
#      .venv 自体はローカルディスクの ASCII パスに置く (各ユーザー
#      別)。共有ドライブ側に日本語があっても、.venv 内部のパス処理
#      (site-packages の絶対パス、ネイティブ拡張のロード等) が
#      日本語/UNC 起因のトラブルに巻き込まれない。
#
# ---------- Windows 10/11 で長いパスを使う場合 ----------
# 日本語文字 (UTF-8) はバイト数が多く、共有ドライブ + 深い階層で
# MAX_PATH=260 の上限に到達することがあります。届きそうな場合は
# 一度だけ管理者権限の PowerShell で長いパス対応を有効化:
#
#   Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem" `
#       -Name "LongPathsEnabled" -Type DWord -Value 1
#
# 再起動 (または再ログイン) 後、Windows API レベルで 32767 文字まで扱える
# ようになります。Python 3.6+ / uv / Rust ツールは全て長いパス対応済み。


# ============================================================
# OpenAI API キー（章 24 でのみ使用、任意）
# ============================================================
# OPENAI_API_KEY=sk-...
